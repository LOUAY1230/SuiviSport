<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SuiviSportApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuiviSport">

        <!-- Écran 1 : Splash (point d'entrée) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran 2 : Accueil (liste des séances) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Écran 3 : Nouvelle séance -->
        <activity
            android:name=".ui.SeanceFormActivity"
            android:exported="false" />

        <!-- Écran 4 : Détail d'une séance (liste des exercices) -->
        <activity
            android:name=".ui.SeanceDetailActivity"
            android:exported="false" />

        <!-- Écran 5 : Nouvel exercice -->
        <activity
            android:name=".ui.ExerciceFormActivity"
            android:exported="false" />

        <!-- Écran 6 : Statistiques -->
        <activity
            android:name=".ui.StatsActivity"
            android:exported="false" />

        <!-- Écran 7 : Réglages -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
    </application>

</manifest>
